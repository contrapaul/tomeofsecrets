{
  "name": "tomeofsecrets",
  "version": "0.0.1",
  "description": "Tome of Secrets: a deckbuilding roguelike",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p worker",
    "lint": "eslint .",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:boundary && npm run test",
    "deploy": "npm run build && wrangler deploy",
    "sim": "vite-node tools/sim.ts --",
    "art": "tsx tools/scan-art.ts",
    "lint:content": "tsx tools/scan-art.ts --check && tsx tools/scan-audio.ts --check && vitest run src/content",
    "art:templates": "tsx tools/make-templates.ts",
    "art:aseprite": "tsx tools/import-aseprite.ts",
    "audio": "tsx tools/scan-audio.ts",
    "art:key": "tsx tools/key-scan.ts",
    "db:migrate": "wrangler d1 migrations apply tomeofsecrets-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tomeofsecrets-db --remote",
    "dev:api": "wrangler dev --port 8788 --local"
  },
  "type": "module",
  "dependencies": {
    "gsap": "^3.15.0",
    "pixi.js": "^8.20.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  },
  "private": true
}
